# Desenvolvimento local. Não use estes valores fora da sua máquina.
PORT=8080
ADMIN_PORT=9086
SPRING_DATASOURCE_USERNAME=orders
SPRING_DATASOURCE_PASSWORD=orders
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=20

# Autenticação máquina a máquina. Em produção use um provedor OIDC (client credentials) e
# ORDERS_AUTH_JWKS_URI em vez do segredo; o segredo abaixo é só para desenvolvimento.
ORDERS_AUTH_ISSUER=order-service-local
ORDERS_AUTH_AUDIENCE=order-service
ORDERS_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop
# ORDERS_AUTH_JWKS_URI=https://idp.example/.well-known/jwks.json

# Moeda padrão dos pedidos que não informam currency e moeda/origem atribuídas aos pedidos gravados antes da 2.0.0.
ORDERS_DEFAULT_CURRENCY=BRL
ORDERS_LEGACY_CURRENCY=BRL
ORDERS_LEGACY_ORIGIN=legacy
