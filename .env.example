# Copie: cp .env.example .env
# Railway injeta PORT; localmente 8080 basta.

PORT=8080
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orders
SPRING_DATASOURCE_USERNAME=orders
SPRING_DATASOURCE_PASSWORD=orders
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MIN_IDLE=5
SPRING_DATASOURCE_HIKARI_CONN_TIMEOUT_MS=30000
